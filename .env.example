# Copy to .env and fill in. Never commit .env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key registered for Firebase App Check
VITE_APPCHECK_SITE_KEY=
# 'enterprise' (default, reCAPTCHA Enterprise key) or 'v3' (classic reCAPTCHA v3 key, no billing)
VITE_APPCHECK_PROVIDER=enterprise
# true only for local development (uses an App Check debug token)
VITE_APPCHECK_DEBUG=false
# 'firebase' (default) or 'mock' (development only, never a real scan)
VITE_SCANNER_MODE=firebase
